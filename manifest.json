{
  "manifest_version": 3,
  "name": "Fanart Storage",
  "version": "1.4.7",
  "description": "store twitter fanart link with browser extension.",
  "icons": {
    "48": "icons/fanart.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fanart Storage",
    "default_icon": {
      "48": "icons/fanart.png"
    }
  },
  "background": {
    "scripts": ["js/background.js"],
	  "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.x.com/*"],
      "js": ["js/content.js", "js/content-live.js"],
      "css": ["css/fanart.css", "css/fanart-live.css"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fanartstorage@extension.local",
	  "data_collection_permissions": {
		"required": ["none"]
	  }
    }
  }
}